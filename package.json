{
  "name": "windows-clip",
  "author": "lumine-code",
  "description": "Native Windows clipboard operations in the tree view.",
  "repository": "https://github.com/lumine-code/windows-clip",
  "bugs": {
    "url": "https://github.com/lumine-code/windows-clip/issues"
  },
  "keywords": [
    "clipboard",
    "native",
    "copy",
    "paste",
    "cut",
    "explorer"
  ],
  "activationCommands": {
    ".platform-win32 .tree-view": [
      "windows-clip:cut",
      "windows-clip:copy",
      "windows-clip:paste",
      "windows-clip:force"
    ]
  },
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "atom": ">=1.100.0 <2.0.0"
  },
  "main": "./lib/main",
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "node-gyp rebuild",
    "clean": "node-gyp clean"
  },
  "consumedServices": {
    "tree-view.selection": {
      "versions": {
        "^1.0.0": "consumeTreeViewSelection"
      }
    }
  },
  "providedServices": {
    "windows-clip": {
      "versions": {
        "1.0.0": "provideWindowsClip"
      }
    }
  },
  "dependencies": {
    "node-addon-api": "^8.5.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.7.0",
    "node-gyp": "^13.0.1",
    "prettier": "^3.9.6"
  }
}
